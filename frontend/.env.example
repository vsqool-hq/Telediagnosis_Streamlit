# URL backendu (Fly.io). Lokalnie: http://localhost:8080
NEXT_PUBLIC_API_BASE=http://localhost:8080

# UWAGA: nie ma tu zmiennej na token API i nie należy jej dodawać.
# Wszystko, co zaczyna się od NEXT_PUBLIC_, jest wkompilowywane w publiczny pakiet
# JavaScript i widoczne dla każdego odwiedzającego stronę. Token administratora
# umieszczony tutaj byłby równoznaczny z opublikowaniem hasła do danych.
# Dostęp do aplikacji uzyskuje się przez logowanie (konto użytkownika albo hasło
# główne = TELEDIAG_API_TOKEN wpisane w formularzu logowania).
